{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "java.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "packages": {
      "type": "object",
      "minItems": 1,
      "patternProperties": {
        "^": {
          "$ref": "java/package.schema.json"
        }
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "additionalItems": false,
      "items": {
        "$ref": "java/method.schema.json"
      }
    }
  }
}
