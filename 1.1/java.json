{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "java",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "packages": {
            "type": "object",
            "minItems": 1,
            "patternProperties": {
                "^": {
                    "$ref": "java/package.json"
                }
            }
        },
        "methods": {
            "type": "array",
            "minItems": 1,
            "additionalItems": false,
            "items": {
                "$ref": "java/method.json"
            }
        }
    }
}