{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "lua.schema.json",
  "type": "object",
  "additionalItems": false,
  "properties": {
    "aliases": {
      "type": "object",
      "minItems": 1,
      "patternProperties": {
        "^": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "lua/alias.schema.json"
          }
        }
      }
    },
    "classes": {
      "type": "object",
      "minItems": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^": {
          "$ref": "lua/class.schema.json"
        }
      }
    },
    "tables": {
      "type": "object",
      "minItems": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^": {
          "$ref": "lua/table.schema.json"
        }
      }
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "additionalItems": false,
      "items": {
        "$ref": "lua/function.schema.json"
      }
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^": {
          "$ref": "lua/field.schema.json"
        }
      }
    }
  }
}
