{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "field.schema.json",
  "type": "object",
  "minItems": 1,
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "deprecated": {
      "type": "boolean",
      "description": "If the field is deprecated."
    },
    "modifiers": {
      "$ref": "modifiers.schema.json"
    },
    "type": {
      "$ref": "type.schema.json"
    },
    "notes": {
      "type": "string"
    },
    "defaultValue": {
      "type": "string"
    },
    "tags": {
      "$ref": "../tags.schema.json"
    }
  },
  "required": ["name", "type"]
}
