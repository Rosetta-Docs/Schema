{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "method.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "modifiers": {
      "$ref": "modifiers.schema.json"
    },
    "deprecated": {
      "type": "boolean",
      "description": "If the method is deprecated."
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "additionalItems": false,
      "items": {
        "$ref": "parameter.schema.json"
      }
    },
    "return": {
      "$ref": "return.schema.json"
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "$ref": "../tags.schema.json"
    }
  },
  "required": ["name", "return"]
}
