{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "constructor.schema.json",
  "type": "object",
  "minItems": 1,
  "additionalProperties": false,
  "properties": {
    "modifiers": {
      "$ref": "modifiers.schema.json"
    },
    "deprecated": {
      "type": "boolean",
      "description": "If the constructor is deprecated."
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "additionalItems": false,
      "items": {
        "$ref": "parameter.schema.json"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
