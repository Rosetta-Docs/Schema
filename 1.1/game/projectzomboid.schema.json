{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "projectzomboid.schema.json",
  "type": "object",
  "minItems": 1,
  "properties": {
    "languages": {
      "type": "object",
      "properties": {
        "java": {
          "type": "object"
        },
        "lua": {
          "type": "object",
          "properties": {
            "events": {
              "type": "array",
              "minItems": 1,
              "additionalItems": false,
              "items": {
                "$ref": "projectzomboid/event.schema.json"
              }
            }
          }
        }
      }
    }
  }
}
