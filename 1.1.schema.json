{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "1.1.schema.json",
  "type": "object",
  "minProperties": 1,
  "additionalItems": true,
  "properties": {
    "version": {
      "description": "The schema version for Rosetta. E.G: 1.1",
      "type": "string"
    },
    "languages": {
      "type": "object",
      "properties": {
        "java": {
          "$ref": "1.1/java.schema.json"
        },
        "lua": {
          "$ref": "1.1/lua.schema.json"
        }
      }
    },
    "games": {
      "type": "object",
      "properties": {
        "projectzomboid": {
          "$ref": "1.1/game/projectzomboid.schema.json"
        }
      }
    },
    "tags": {
      "$ref": "1.1/tags.schema.json"
    }
  },
  "required": ["version"]
}
