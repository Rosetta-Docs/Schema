{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "namespace.schema.json",
  "type": "object",
  "additionalItems": false,
  "properties": {
    "namespaces": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^": {
          "$ref": "namespace.schema.json"
        }
      }
    },
    "aliases": {
      "type": "object",
      "minItems": 1,
      "patternProperties": {
        "^": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "alias.schema.json"
          }
        }
      }
    },
    "classes": {
      "type": "object",
      "minItems": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^": {
          "$ref": "class.schema.json"
        }
      }
    },
    "tables": {
      "type": "object",
      "minItems": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^": {
          "$ref": "table.schema.json"
        }
      }
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "additionalItems": false,
      "items": {
        "$ref": "function.schema.json"
      }
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^": {
          "$ref": "field.schema.json"
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "$ref": "../tags.schema.json"
    }
  }
}
