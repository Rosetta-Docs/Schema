{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "function.schema.json",
  "type": "object",
  "minItems": 1,
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "static": {
      "type": "boolean",
      "description": "Default: False"
    },
    "deprecated": {
      "type": ["boolean", "string"],
      "description": "If the function is deprecated."
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "parameter.schema.json"
      }
    },
    "return": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "$ref": "return.schema.json"
          }
        ]
      }
    },
    "overloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "overload.schema.json"
      }
    },
    "generics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "$ref": "generic.schema.json"
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "$ref": "../tags.schema.json"
    }
  },
  "required": ["name"]
}
