{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "class.schema.json",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": false,
  "properties": {
    "scope": {
      "type": "string",
      "enum": ["public", "package", "protected", "private"]
    },
    "static": {
      "type": "boolean",
      "description": "Default: False"
    },
    "final": {
      "type": "boolean",
      "description": "Default: False"
    },
    "type_parameters": {
      "type": "array",
      "minItems": 1,
      "additionalItems": false,
      "items": {
        "$ref": "type_parameter.schema.json"
      }
    },
    "deprecated": {
      "type": ["boolean", "string"],
      "description": "If the class is deprecated."
    },
    "extends": {
      "type": "object",
      "anyOf": [
        {
          "$ref": "type.schema.json"
        },
        {
          "$ref": "string"
        }
      ]
    },
    "implements": {
      "type": "array",
      "minItems": 1,
      "anyOf": [
        {
          "$ref": "type.schema.json"
        },
        {
          "$ref": "string"
        }
      ]
    },
    "classes": {
      "patternProperties": {
        "^": {
          "$ref": "class.schema.json"
        }
      }
    },
    "fields": {
      "type": "object",
      "minItems": 1,
      "patternProperties": {
        "^": {
          "$ref": "field.schema.json"
        }
      }
    },
    "constructors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "constructor.schema.json"
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "method.schema.json"
      }
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "$ref": "../tags.schema.json"
    }
  }
}
