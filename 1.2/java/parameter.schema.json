{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "parameter.schema.json",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "final": {
      "type": "boolean",
      "description": "Default: False"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "$ref": "type_reference.schema.json"
    },
    "nullable": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": ["name", "type"]
}
