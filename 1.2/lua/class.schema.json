{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "class.schema.json",
  "type": "object",
  "minItems": 1,
  "additionalProperties": false,
  "properties": {
    "deprecated": {
      "type": ["boolean", "string"],
      "description": "If the class is deprecated."
    },
    "extends": {
      "type": "string"
    },
    "mutable": {
      "type": "boolean",
      "description": "If true, the Lua class will allow foreign properties assigned to it. E.G: '--- @field [any] any'"
    },
    "local": {
      "type": "boolean",
      "description": "If true, the class should be emitted as a local variable."
    },
    "constructors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "constructor.schema.json"
      }
    },
    "fields": {
      "type": "object",
      "minItems": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^": {
          "$ref": "field.schema.json"
        }
      }
    },
    "overloads": {
      "type": "array",
      "minItems": 1,
      "additionalItems": false,
      "items": {
        "$ref": "overload.schema.json"
      }
    },
    "operators": {
      "type": "array",
      "minItems": 1,
      "additionalItems": false,
      "items": {
        "$ref": "operator.schema.json"
      }
    },
    "generics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "generic.schema.json"
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "additionalItems": false,
      "items": {
        "$ref": "method.schema.json"
      }
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "$ref": "../tags.schema.json"
    }
  }
}
