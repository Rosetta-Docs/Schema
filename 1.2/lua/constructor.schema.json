{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "constructor.schema.json",
  "type": "object",
  "minItems": 1,
  "additionalProperties": false,
  "properties": {
    "deprecated": {
      "type": ["boolean", "string"],
      "description": "If the function is deprecated."
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "parameter.schema.json"
      }
    },
    "generics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "generic.schema.json"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
