{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "callback.schema.json",
  "type": "object",
  "minItems": 1,
  "additionalProperties": false,
  "properties": {
    "parameters": {
      "type": "array",
      "minItems": 1,
      "additionalItems": false,
      "items": {
        "$ref": "parameter.schema.json"
      }
    },
    "return": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "$ref": "return.schema.json"
          }
        ]
      }
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "$ref": "../tags.schema.json"
    }
  }
}
