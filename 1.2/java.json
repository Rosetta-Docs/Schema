{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "http://rosetta-docs.com/schema/1.2/java.json",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "packages": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^": {
          "$ref": "java/package.json"
        }
      }
    },
    "types": {
      "description": "(Optional) A dictionary of unique integer-id type definitions to reference throughout the set. If defined, `types_format` must be defined.",
      "oneOf": [
        {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^": {
              "anyOf": [
                {
                  "$ref": "java/type.json"
                },
                {
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "$ref": "java/type.json"
              },
              {
                "type": "string"
              }
            ]
          }
        }
      ]
    },
    "types_format": {
      "type": "string",
      "enum": ["dictionary", "list", "none"],
      "description": "(Optional) The format of type-dictionary that is stored in the Rosetta context."
    }
  },
  "dependencies": {
    "types": ["types_format"]
  }
}
