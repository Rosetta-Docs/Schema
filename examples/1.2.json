{
  "id": "Example",
  "$schema": "https://rosetta-docs.com/schema/1.2.schema.json",
  "version": "1.2",
  "languages": {
    "java": {
      "packages": {
        "example": {
          "packages": {
            "foobar": {
              "objects": {
                "ExampleClass": {
                  "type": "class",
                  "extends": "java.lang.Object"
                }
              }
            }
          }
        }
      }
    },
    "lua": {
      "classes": {
        "ExampleLuaClass": {
          "constructors": [
            {
              "notes": "",
              "deprecated": false,
              "parameters": [
                {
                  "name": "param1",
                  "type": "number",
                  "notes": "",
                  "nullable": false,
                  "optional": true
                }
              ]
            }
          ],
          "tags": ["example", "rendering", "ui"],
          "extends": "ISBaseObject",
          "notes": "",
          "deprecated": false,
          "mutable": true
        }
      },
      "tables": {
        "ExampleLuaTable": {
          "notes": "",
          "deprecated": false,
          "mutable": true
        }
      },
      "fields": {
        "ExampleField": {
          "notes": "",
          "nullable": true,
          "type": "number"
        }
      },
      "functions": [
        {
          "name": "ExampleFunction",
          "notes": "",
          "deprecated": false,
          "parameters": [
            {
              "name": "param1",
              "type": "number",
              "notes": "",
              "nullable": false,
              "optional": true
            }
          ],
          "return": ["number"]
        }
      ]
    }
  }
}
